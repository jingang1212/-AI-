# 阿里云百炼（DashScope）—— 把 key 填这里，不要提交到 git
# Key 有两种来源，地址必须配套使用，不能混：
#   A) 百炼控制台「API-KEY 管理」创建：key 形如 sk-xxxx，用公网地址 dashscope.aliyuncs.com
#   B) 「API 快捷接入」生成的专属网关：key 形如 sk-ws-xxx，用形如
#      https://llm-xxxxxxxx.cn-beijing.maas.aliyuncs.com 的专属地址
# 填错的表现是 401 InvalidApiKey 或模型找不到。
DASHSCOPE_API_KEY=sk-你的key
EMBED_MODEL=qwen3.7-text-embedding
CHAT_MODEL=qwen3.8-flash
RERANK_MODEL=qwen3.7-text-rerank
# 公网版：https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 公网版：https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 关掉思考模式（默认）：qwen3.8-flash 开思考时 tool_choice="required" 会 400
ENABLE_THINKING=false

# Redis（可选）：LangGraph checkpointer（会话记忆/断点续跑/多副本一致）
# 和人工确认挂起登记表。留空 = 内存模式（重启丢会话）。
# 启用需要 Redis Stack（checkpointer 依赖 RedisJSON 模块）：
#   docker run -d -p 6379:6379 redis/redis-stack-server
# 启动时会校验连通性与 RedisJSON，校验失败直接启动报错，不做降级。
# REDIS_URL=redis://127.0.0.1:6379/0
# 注：Redis < 6 时代码会用 RESP2 协议连接（redis-py 5 默认 RESP3 会握手失败）

# 向量库（Milvus）：默认嵌入式 Milvus Lite（本地文件，零部署）。
# 生产换服务端：MILVUS_URI=http://127.0.0.1:19530（托管版加 MILVUS_TOKEN）
# MILVUS_URI=./data/milvus_lite.db
# MILVUS_COLLECTION=knowledge_chunks

# 数据目录
DATA_DIR=./data
